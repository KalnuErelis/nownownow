---
import { addVat, extractVat, formatEur } from "@/lib/vat";

const examples = [
  { label: "100 € be PVM, tarifas 21 %", result: addVat(100, 0.21), mode: "pridėti" },
  { label: "121 € su PVM, tarifas 21 %", result: extractVat(121, 0.21), mode: "išskirti" },
  { label: "100 € be PVM, tarifas 12 %", result: addVat(100, 0.12), mode: "pridėti" },
  { label: "200 € be PVM, tarifas 5 %", result: addVat(200, 0.05), mode: "pridėti" },
  { label: "210 € su PVM, tarifas 5 %", result: extractVat(210, 0.05), mode: "išskirti" },
  {
    label: "100 € be PVM, istorinis 9 % (iki 2025-12-31)",
    result: addVat(100, 0.09),
    mode: "pridėti"
  }
] as const;

const initial = examples[0].result;
---

<div class="lt-calc" data-vat-calc>
  <form class="lt-calc__form">
    <label>
      Suma, €
      <input name="amount" type="number" inputmode="decimal" min="0" step="0.01" value="100" required />
    </label>
    <label>
      Tarifas
      <select name="rate">
        <option value="0.21" selected>21 % — standartinis</option>
        <option value="0.12">12 % — lengvatinis nuo 2026-01-01</option>
        <option value="0.05">5 % — lengvatinis</option>
        <option value="0.09">9 % — galiojo iki 2025-12-31</option>
      </select>
    </label>
    <fieldset>
      <legend>Veiksmas</legend>
      <label>
        <input type="radio" name="mode" value="add" checked />
        Pridėti PVM
      </label>
      <label>
        <input type="radio" name="mode" value="extract" />
        Išskirti PVM
      </label>
    </fieldset>
    <button type="submit">Skaičiuoti</button>
  </form>
  <p class="lt-calc__result" data-result aria-live="polite">
    Suma be PVM {formatEur(initial.net)}, PVM {formatEur(initial.vat)}, suma su PVM {formatEur(initial.gross)}.
  </p>
  <noscript>
    <p>Be JavaScript skaičiuoklė neperskaičiuoja. Pavyzdžiai lentelėje jau yra suskaičiuoti.</p>
  </noscript>
</div>

<h2 id="pavyzdziai">Suskaičiuoti pavyzdžiai</h2>
<p>
  Pridėti: suma su PVM = suma be PVM × (1 + tarifas). Išskirti: suma be PVM = suma su PVM / (1 + tarifas). PVM yra šių dviejų sumų skirtumas.
</p>
<div class="lt-table-wrap">
  <table class="lt-table">
    <caption>PVM pavyzdžiai, suskaičiuoti serverijoje</caption>
    <thead>
      <tr>
        <th scope="col">Atvejis</th>
        <th scope="col">Be PVM</th>
        <th scope="col">PVM</th>
        <th scope="col">Su PVM</th>
      </tr>
    </thead>
    <tbody>
      {
        examples.map((example) => (
          <tr>
            <th scope="row">{example.label}</th>
            <td>{formatEur(example.result.net)}</td>
            <td>{formatEur(example.result.vat)}</td>
            <td>{formatEur(example.result.gross)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<script>
  import { addVat, extractVat, formatEur } from "@/lib/vat";

  function initVatCalculators() {
    document.querySelectorAll("[data-vat-calc]").forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;
      const form = root.querySelector("form");
      const result = root.querySelector("[data-result]");
      if (!(form instanceof HTMLFormElement) || !(result instanceof HTMLElement)) return;
      root.dataset.ready = "true";

      const calculate = () => {
        const data = new FormData(form);
        const amount = Number(data.get("amount"));
        const rate = Number(data.get("rate"));
        const mode = String(data.get("mode"));
        if (!Number.isFinite(amount) || amount < 0 || !Number.isFinite(rate)) {
          result.textContent = "Įveskite neneigiamą sumą.";
          return;
        }

        const breakdown = mode === "extract" ? extractVat(amount, rate) : addVat(amount, rate);
        const historical = rate === 0.09 ? " Tarifas 9 % galiojo iki 2025-12-31." : "";
        result.textContent = `Suma be PVM ${formatEur(breakdown.net)}, PVM ${formatEur(breakdown.vat)}, suma su PVM ${formatEur(breakdown.gross)}.${historical}`;
      };

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        calculate();
      });
      form.addEventListener("input", calculate);
    });
  }

  initVatCalculators();
  document.addEventListener("astro:page-load", initVatCalculators);
</script>
