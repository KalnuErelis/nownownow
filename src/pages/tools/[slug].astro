---
import AffiliateDisclosure from "@/components/AffiliateDisclosure.astro";
import ToolCta from "@/components/ToolCta.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { SITE } from "@/data/site";
import {
  TOOLS,
  categoriesFor,
  getCategoryById,
  getRankedTools,
  type Tool
} from "@/data/tools";

export function getStaticPaths() {
  return TOOLS.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool }
  }));
}

const { tool } = Astro.props as { tool: Tool };
const primaryCategory = getCategoryById(tool.category);
const listedIn = categoriesFor(tool);
const siblings = getRankedTools(tool.category).filter((entry) => entry.slug !== tool.slug);
const pageUrl = new URL(tool.href, SITE.url).toString();
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Tools",
        item: new URL("/tools/", SITE.url).toString()
      },
      {
        "@type": "ListItem",
        position: 2,
        name: primaryCategory.label,
        item: new URL(primaryCategory.href, SITE.url).toString()
      },
      {
        "@type": "ListItem",
        position: 3,
        name: tool.name,
        item: pageUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: tool.name,
    description: tool.summary,
    url: pageUrl
  }
];
---

<SiteLayout title={`${tool.name} | ${SITE.title}`} description={tool.summary} schema={schema}>
  <main id="main-content" class="page-shell tools-page">
    <section class="hero">
      <div class="hero-copy">
        <nav class="tools-breadcrumb" aria-label="Breadcrumb">
          <a href="/tools/">Tools</a>
          <span aria-hidden="true">/</span>
          <a href={primaryCategory.href}>{primaryCategory.label}</a>
        </nav>
        <h1>{tool.name}</h1>
        <p class="tools-best-for">Best for: {tool.bestFor}</p>
        <p>{tool.summary}</p>
        <AffiliateDisclosure />
        <ToolCta href={tool.outboundHref} label={`Visit ${tool.name}`} />
      </div>
    </section>

    <section class="tools-section">
      <h2>Who it's for</h2>
      <p>{tool.audience}</p>
    </section>

    <div class="tools-split">
      <section class="tools-section">
        <h2>Pros</h2>
        <ul class="tools-points">
          {tool.pros.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>
      <section class="tools-section">
        <h2>Cons</h2>
        <ul class="tools-points">
          {tool.cons.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>
    </div>

    {tool.pricing && (
      <section class="tools-section">
        <h2>Pricing</h2>
        <p class="tools-pricing">{tool.pricing}</p>
      </section>
    )}

    {listedIn.length > 1 && (
      <section class="tools-section">
        <h2>Listed in</h2>
        <ul class="tools-links">
          {listedIn.map((category) => (
            <li>
              <a href={category.href}>{category.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {siblings.length > 0 && (
      <section class="tools-section">
        <h2>Also in {primaryCategory.label}</h2>
        <ul class="tools-links">
          {siblings.map((sibling) => (
            <li>
              <a href={sibling.href}>{sibling.name}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</SiteLayout>
