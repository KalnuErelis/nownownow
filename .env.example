# Click logging. Redirects work without these; hits are not stored.
# Vercel → Project → Storage → Create → Upstash Redis (Marketplace).
# Connecting the database adds the two Upstash variables. KV_REST_API_URL and
# KV_REST_API_TOKEN are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HMAC salt for the visitor dedupe hash. Generate with: openssl rand -hex 32
# Raw IPs are never stored. Without a salt, clicks are still counted, but
# repeat clicks inside 30 minutes cannot be collapsed.
GO_CLICK_SALT=

# Bearer token for GET /api/go-stats. Generate with: openssl rand -hex 32
# The endpoint stays closed until this is set.
GO_STATS_TOKEN=
